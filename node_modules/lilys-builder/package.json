{
  "name": "lilys-builder",
  "version": "1.0.0",
  "description": "Baileys Interactive support MessageBuilder Nixel - OpenSource",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./lib/index.mjs"
    }
  },
  "scripts": {
    "postinstall": "node lib/index.js --install",
    "update": "node lib/index.js --update"
  },
  "keywords": [
    "lilys-baileys",
    "baileys",
    "whatsapp",
    "message-builder",
    "button",
    "carousel",
    "native-flow",
    "interactive-message"
  ],
  "author": "FallEzz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FallEzz/lilys-messagebuild.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/FallEzz/lilys-messagebuild/issues"
  },
  "homepage": "https://github.com/FallEzz/lilys-messagebuild",
  "dependencies": {
    "fluent-ffmpeg": "*",
    "sharp": "^0.33.0",
    "stream": "*"
  },
  "optionalDependencies": {
    "baileys": "*"
  }
}

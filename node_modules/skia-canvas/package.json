{
  "name": "skia-canvas",
  "version": "4.0.0",
  "description": "A uniquely capable, unusually fast Canvas API for Node",
  "author": "Christian Swinehart <drafting@samizdat.co>",
  "license": "MIT",
  "homepage": "https://skia-canvas.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samizdatco/skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/samizdatco/skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": "./lib/browser.js",
    "types": "./lib/index.d.ts"
  },
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "download": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "test": "node tests/runner"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "follow-redirects": "^1.16.1",
    "https-proxy-agent": "^9.1.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@types/node": "^26.6.3",
    "chalk": "^6.0.1",
    "clean-stack": "^6.0.0",
    "hono": "^4.13.12",
    "jest-diff": "^30.5.2",
    "sharp": ">=0.33.5"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts"
  ],
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "volta": {
    "node": "24.18.0"
  },
